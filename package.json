{
  "name": "debug-students",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "prisma migrate deploy && next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx --test \"tests/**/*.test.mts\"",
    "test:e2e": "bash tests/e2e.sh",
    "test:pw": "playwright test",
    "test:pw:compose": "bash e2e/run-compose.sh",
    "dev:mock": "NEXT_PUBLIC_API_MODE=mock NEXT_DIST_DIR=node_modules/.cache/next-mockui next dev -p 3000",
    "db:up": "docker compose up -d --wait db",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:import": "tsx --env-file-if-exists=.env scripts/import-data.ts",
    "postinstall": "prisma generate",
    "vercel-build": "bash scripts/vercel-build.sh"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "@prisma/client": "^6.19.3",
    "next": "^15.5.25",
    "prisma": "^6.19.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.9"
  }
}
