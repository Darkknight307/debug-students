{
  "name": "debug-students",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma migrate deploy && DATABASE_URL=${DATABASE_URL:-file:./dev.db} next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "tsx --test \"tests/**/*.test.mts\"",
    "test:e2e": "bash tests/e2e.sh",
    "dev:mock": "NEXT_PUBLIC_API_MODE=mock NEXT_DIST_DIR=node_modules/.cache/next-mockui next dev -p 3000",
    "db:deploy": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma migrate deploy",
    "db:migrate": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} prisma migrate dev",
    "db:seed": "DATABASE_URL=${DATABASE_URL:-file:./dev.db} tsx --env-file-if-exists=.env prisma/seed.ts",
    "postinstall": "prisma generate",
    "vercel-build": "prisma generate && tsx scripts/db-migrate-libsql.ts && tsx prisma/seed.ts && next build",
    "db:migrate:libsql": "tsx --env-file-if-exists=.env scripts/db-migrate-libsql.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.4",
    "@libsql/client": "^0.8.1",
    "@prisma/adapter-libsql": "^6.19.3",
    "@prisma/client": "^6.19.3",
    "next": "^15.5.25",
    "prisma": "^6.19.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.9"
  }
}
