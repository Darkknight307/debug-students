# DEBUG · Студенттер — сайттың айнымалылары. Осы файлды .env.local деп көшіріп, мәндерін толтырыңыз.
# Мәндерді чатқа жазбаңыз. Vercel → Project → Settings → Environment Variables-қа да осыларды қойыңыз.

# Supabase → Project Settings → API (жаңа жоба! ескі debug-2026 жобасынікін қолданбаңыз)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role — құпия, тек серверде. Ешқашан NEXT_PUBLIC_ префиксімен қоймаңыз.
SUPABASE_SERVICE_ROLE_KEY=

# Ұсынылады: Supabase → Project Settings → API Keys → Secret key (sb_secret_…). Құпия, тек серверде.
# Қойылса, тіркелу/кіру шақыруларына студенттің өз IP-і (Sb-Forwarded-For) қосылады — Supabase-тің
# IP бойынша шегі (тіркелу 30 / 5 мин, кіру 150 / 5 мин) бүкіл сайтқа емес, әр студентке бөлек түседі.
# Ол үшін Supabase → Authentication → Rate Limits → «IP Address Forwarding» қосулы болуы керек.
SUPABASE_SECRET_KEY=

# Сессия қолтаңбасы: кемінде 32 кездейсоқ таңба (мысалы: openssl rand -base64 48). Ескі сайттікін қолданбаңыз.
SESSION_SECRET=

# Vercel Cron (/api/cron/keepalive) құпиясы
CRON_SECRET=

# Сайттың толық мекенжайы (хаттағы сілтемелер үшін)
NEXT_PUBLIC_SITE_URL=https://debug-students.vercel.app

# Custom SMTP бапталған соң 1 қойыңыз: «Құпия сөзді ұмыттым» хат жіберетін форманы көрсетеді.
# Бос болса, форма орнына «ұйымдастырушыға хабарласыңыз» деген жазу шығады.
AUTH_EMAILS_ENABLED=
