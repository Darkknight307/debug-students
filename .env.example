# DEBUG · Студенттер — айнымалылар. Осыны .env деп көшіріп, мәндерін толтырыңыз. Құпияларды репоға салмаңыз.

# Дерекқор: postgres (әдепкі, Prisma ORM → PostgreSQL) немесе memory (тест/демо, қайта қосқанда өшеді)
DB_DRIVER=postgres
# Жергілікті Postgres: npm run db:up (Docker Compose-тағы db, тек 127.0.0.1-де). Порт бос болмаса — DB_PORT=5433
DATABASE_URL="postgresql://debug:debug@localhost:5432/debug"
DB_PORT=5432
# Тесттердің дерекқоры (әр іске қосу өз уақытша схемасын жасап, соңында өшіреді)
TEST_DATABASE_URL="postgresql://debug:debug@localhost:5432/debug"

# Сессия қолтаңбасы: кемінде 32 кездейсоқ таңба (openssl rand -base64 48)
SESSION_SECRET=

# Бірінші әкімші (npm run db:seed, SEED_ON_START=1 не алғашқы кіру кезінде құрылады)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Сайттың толық мекенжайы (қалпына келтіру сілтемелері үшін)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cron (/api/cron/keepalive) құпиясы — продакшнде
CRON_SECRET=

# 1 — «Құпия сөзді ұмыттым» продакшнде де көрсетіледі (SMTP бапталған соң, #48)
AUTH_EMAILS_ENABLED=

# Docker Compose (docker compose up): сайт порты және бірінші іске қосуда seed (әкімші + бірінші жарыс)
APP_PORT=3000
SEED_ON_START=1
