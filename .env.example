# DEBUG · Студенттер — айнымалылар. Осыны .env деп көшіріп, мәндерін толтырыңыз. Құпияларды репоға салмаңыз.

# Дерекқор: sqlite (әдепкі, Prisma ORM) немесе memory (тест/демо, қайта қосқанда өшеді)
DB_DRIVER=sqlite
DATABASE_URL="file:./dev.db"
# Продакшн: Turso (бұлттағы SQLite). Берілсе, DATABASE_URL орнына осы қолданылады (Vercel → Storage → Turso өзі қосады)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Сессия қолтаңбасы: кемінде 32 кездейсоқ таңба (openssl rand -base64 48)
SESSION_SECRET=

# Бірінші әкімші (npm run db:seed не алғашқы кіру кезінде құрылады)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Сайттың толық мекенжайы (қалпына келтіру сілтемелері үшін)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cron (/api/cron/keepalive) құпиясы — продакшнде
CRON_SECRET=

# 1 — «Құпия сөзді ұмыттым» продакшнде де көрсетіледі (SMTP бапталған соң, #48)
AUTH_EMAILS_ENABLED=
